[run]
omit =
    */__main__.py
    */demo_*.py
    econ_capital/op_risk/reporting.py
    econ_capital/op_risk/oprisk_reporting.py
    econ_capital/op_risk/run_oprisk_report.py
    econ_capital/market_risk/marketrisk_reporting.py
    econ_capital/market_risk/run_marketrisk_report.py
    econ_capital/credit_risk/creditrisk_reporting.py
    econ_capital/credit_risk/run_creditrisk_report.py
    econ_capital/credit_risk/generate_portfolio.py
    notebooks/*

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    raise AssertionError
    if __name__ == "__main__":
    if TYPE_CHECKING:
    ^\s*#\s*type:

[html]
directory = htmlcov
