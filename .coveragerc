[run]
omit =
    */__main__.py
    */demo_*.py
    econ_capital/op_risk/reporting.py
    econ_capital/op_risk/stress_tests.py
    notebooks/*

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    raise AssertionError
    if __name__ == "__main__":
    if TYPE_CHECKING:
    ^\s*#\s*type:

[html]
directory = htmlcov